# ==================== Application ====================
APP_NAME=Course Agent Workspace
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO

# ==================== Chat model ====================
# Options: openai_compatible, deepseek, ollama
MODEL_PROVIDER=openai_compatible
MODEL_NAME=
MODEL_API_KEY=
MODEL_BASE_URL=
MODEL_TEMPERATURE=0.2

# ==================== Embedding model ====================
# Options: openai_compatible, ollama
EMBEDDING_PROVIDER=openai_compatible
EMBEDDING_MODEL=Pro/BAAI/bge-m3
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_DIMENSION=1024

# ==================== Storage switches ====================
# memory starts without databases; postgres/milvus enable persistence.
SHORT_TERM_MEMORY_BACKEND=memory
LONG_TERM_MEMORY_BACKEND=memory
VECTOR_STORE_BACKEND=memory

# PostgreSQL is shared by PostgresSaver and PostgresStore.
POSTGRES_URI=

# Milvus is only required when VECTOR_STORE_BACKEND=milvus.
MILVUS_URI=http://localhost:19530
MILVUS_TOKEN=
MILVUS_DATABASE=course_agent
MILVUS_COLLECTION=knowledge_chunks

# ==================== Optional capabilities ====================
ENABLE_RAG=true
ENABLE_WEB_SEARCH=false
TAVILY_API_KEY=

ENABLE_SUMMARIZATION=false
SUMMARY_TRIGGER_MESSAGES=12
SUMMARY_KEEP_MESSAGES=6
ENABLE_PII_PROTECTION=false

LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=course-agent-mvp

# RAG defaults
RAG_TOP_K=4
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=100
KNOWLEDGE_DIR=knowledge

